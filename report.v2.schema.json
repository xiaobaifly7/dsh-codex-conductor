{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "criteria", "files_changed", "deviations", "unresolved", "blockers"],
  "properties": {
    "summary": { "type": "string" },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": { "type": "string" },
          "status": { "type": "string", "enum": ["met", "not_met", "blocked"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "deviations": { "type": "array", "items": { "type": "string" } },
    "unresolved": { "type": "array", "items": { "type": "string" } },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "message", "question", "resolution"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["user_input", "task_conflict", "environment", "implementation"] },
          "message": { "type": "string" },
          "question": { "type": "string" },
          "resolution": { "type": "string" }
        }
      }
    }
  }
}
